---
import '../styles/global.css';
import { REPO_URL } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** The header sits over a dark ink field (the home page hero). */
  onInk?: boolean;
}
const {
  onInk = false,
  title = 'Projek Seratus',
  description = 'Projek Seratus: 100 open-source projects by Malaysians for one cause: tech sovereignty for Malaysia. Open source, so anyone can start their own.',
} = Astro.props;
const path = Astro.url.pathname;
const SITE = 'https://projek-seratus.artifisi.com';
const pageUrl = new URL(path, SITE).href;
const ogImage = `${SITE}/og.png`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Projek Seratus" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Projek Seratus: 100 projects, one cause. Seratus projek, satu tujuan." />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:locale:alternate" content="ms_MY" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@800&family=Public+Sans:wght@400;600;700&display=swap" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <header class={`top${onInk ? ' on-ink' : ''}`}>
      <a class="brand" href="/" aria-label="Projek Seratus, home">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
        Projek Seratus
      </a>
      <nav aria-label="Sections">
        <a class="hide-sm" href="/#board" data-i18n="nav.board">The board</a>
        <a class="hide-sm" href="/#how" data-i18n="nav.how">How it works</a>
        <a class="hide-sm" href="/#fork" data-i18n="nav.fork">Start your own</a>
        <div class="lang" role="group" aria-label="Language / Bahasa">
          <button type="button" data-lang="en" aria-pressed="true" aria-label="English">EN</button>
          <button type="button" data-lang="ms" aria-pressed="false" aria-label="Bahasa Melayu">BM</button>
        </div>
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="foot f-kunyit">
      <div class="foot-top">
        <div class="notes">
          <span class="brand"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>Projek Seratus</span>
          <span data-i18n="foot.n1">One hundred projects for one cause, built in the open by a Malaysian community.</span>
          <span data-i18n="foot.n2">There is no group chat yet. Watch the repository on GitHub for news.</span>
        </div>
        <a class="link" href="#top" data-i18n="foot.top">Back to top</a>
      </div>
      <div class="foot-big">
        {path.startsWith('/apply') ? (
          <>
            <h2 data-i18n="foot.h2">See who is on it</h2>
            <a href="/#board"><span data-i18n="foot.cta2">Back to the board</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </>
        ) : (
          <>
            <h2 data-i18n="foot.h">Ready when you are</h2>
            <a href="/apply"><span data-i18n="foot.cta">Submit a project</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
          </>
        )}
      </div>
      <div class="foot-meta">
        <div><a class="link" href={REPO_URL} target="_blank" rel="noopener">GitHub</a><a class="link" href={`${REPO_URL}/blob/main/LICENSE`} target="_blank" rel="noopener" data-i18n="foot.lic">MIT licence</a></div>
        <div data-i18n="foot.made">Open source. Fork it and run your own.</div>
        <div>Malaysia, 2026</div>
      </div>
    </footer>

    <script>
      import { initLang } from '../lib/i18n';
      import '../scripts/reveal';
      initLang();
    </script>
  </body>
</html>
