---
import Base from '../layouts/Base.astro';
import { REPO, BRANCH } from '../lib/site';
---
<Base title="Submit a project · Projek Seratus" description="Submit your project to Projek Seratus with a GitHub pull request.">
  <section class="apply-sec f-paper">
    <div class="grid">
      <div class="apply-intro">
        <h1 class="display lines">
          <span class="line"><span data-line style="--i:0" data-i18n="apply.title1">Put your project</span></span>
          <span class="line"><span data-line style="--i:1" data-i18n="apply.title2">on the board</span></span>
        </h1>
        <p class="lead" data-reveal style="--d:1" data-i18n="apply.lede">Fill this in and we'll prepare your submission file. You send it as a pull request on GitHub. Once it's merged, your project joins the ranking.</p>
      </div>
      <div class="apply-more" data-reveal style="--d:2">
        <h2 data-i18n="apply.stepsT">What happens next</h2>
        <ol class="apply-steps">
          <li><span data-i18n="apply.step1">GitHub opens your filled-in file. If it asks, fork the repository first.</span></li>
          <li><span data-i18n="apply.step2">Press <b>Commit changes</b>, then <b>Create pull request</b>.</span></li>
          <li><span data-i18n="apply.step3">An automatic check looks over your file. Once an organiser merges it, your project appears on the board within a day.</span></li>
        </ol>
        <p class="hint" data-i18n="apply.rankHint">You don't pick a slot. The hundred projects with the most GitHub stars fill the board, and stars are counted every day.</p>
      </div>

      <form class="form" id="submit-form" data-reveal style="--d:2" novalidate data-repo={REPO} data-branch={BRANCH}>
        <p class="err" id="e-form" role="alert" hidden></p>
        <div class="field">
          <label for="f-title" data-i18n="apply.f.title">Project title</label>
          <input id="f-title" type="text" maxlength="80" required aria-describedby="h-title" />
          <small id="h-title" data-i18n="apply.f.titleHint">Also used as the file name.</small>
        </div>
        <div class="field">
          <label for="f-github" data-i18n="apply.f.github">GitHub repository</label>
          <input id="f-github" type="url" inputmode="url" required spellcheck="false" placeholder="https://github.com/owner/repo" aria-describedby="h-github e-github" />
          <small id="h-github" data-i18n="apply.f.githubHint">Its stars decide the project's place on the board.</small>
          <span class="err" id="e-github" hidden></span>
        </div>
        <div class="field">
          <label for="f-website" data-i18n="apply.f.website">Website (optional)</label>
          <input id="f-website" type="url" inputmode="url" spellcheck="false" placeholder="https://" aria-describedby="h-website e-website" />
          <small id="h-website" data-i18n="apply.f.websiteHint">A demo, a project page, or wherever people can try it.</small>
          <span class="err" id="e-website" hidden></span>
        </div>

        <div class="file" data-ui>
          <div class="term-bar"><span><span data-i18n="apply.preview">Your submission file</span> · <span id="file-name">submissions/….md</span></span></div>
          <pre id="preview"></pre>
        </div>

        <div class="actions">
          <a class="btn btn-ink" id="open-pr" href="#" target="_blank" rel="noopener"><span data-i18n="apply.submit">Open pull request on GitHub</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { t } from '../lib/i18n';
  import { slugify } from '../lib/site';

  const form = document.getElementById('submit-form') as HTMLFormElement;
  const REPO_RE = /^https:\/\/github\.com\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+\/?$/;
  const WEB_RE = /^https?:\/\/[^\s]+$/;
  const { repo, branch } = form.dataset as { repo: string; branch: string };
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;

  const values = () => ({
    title: $('f-title').value.trim(),
    github: $('f-github').value.trim().replace(/\/+$/, '').replace(/\.git$/, ''),
    website: $('f-website').value.trim(),
  });

  const fileText = (v: ReturnType<typeof values>) => [
    '---',
    `title: ${JSON.stringify(v.title)}`, // YAML reads JSON-style double-quoted strings
    `github_url: ${v.github}`,
    ...(v.website ? [`website_url: ${v.website}`] : []),
    '---',
    '',
  ].join('\n');

  const setErr = (id: string, key: string | null) => {
    const e = document.getElementById(id)!; e.hidden = !key; e.textContent = key ? t(key) : '';
  };

  function validate(v: ReturnType<typeof values>, show: boolean) {
    const titleOk = !!v.title && !!slugify(v.title);
    const repoOk = REPO_RE.test(v.github);
    const webOk = !v.website || WEB_RE.test(v.website);
    if (show) {
      setErr('e-form', titleOk ? null : 'apply.err.title');
      setErr('e-github', repoOk ? null : 'apply.err.github');
      setErr('e-website', webOk ? null : 'apply.err.website');
      $('f-title').setAttribute('aria-invalid', String(!titleOk));
      $('f-github').setAttribute('aria-invalid', String(!repoOk));
      $('f-website').setAttribute('aria-invalid', String(!webOk));
    }
    return titleOk && repoOk && webOk;
  }

  const preview = document.getElementById('preview')!;
  const fileName = document.getElementById('file-name')!;
  const btn = document.getElementById('open-pr') as HTMLAnchorElement;
  let tried = false;

  function update() {
    const v = values();
    const name = `${slugify(v.title) || '…'}.md`;
    const text = fileText(v);
    fileName.textContent = `submissions/${name}`;
    preview.textContent = text;
    const ok = validate(v, tried);
    btn.href = ok
      ? `https://github.com/${repo}/new/${branch}/submissions?filename=${encodeURIComponent(name)}&value=${encodeURIComponent(text)}`
      : '#';
    btn.setAttribute('aria-disabled', String(!ok));
  }

  form.addEventListener('input', update);
  form.addEventListener('submit', (e) => e.preventDefault());
  btn.addEventListener('click', (e) => {
    tried = true;
    update();
    if (btn.getAttribute('aria-disabled') === 'true') {
      e.preventDefault();
      const firstBad = form.querySelector<HTMLInputElement>('[aria-invalid="true"]');
      firstBad?.focus();
    }
  });
  document.addEventListener('langchange', () => { if (tried) update(); });
  update();
</script>
