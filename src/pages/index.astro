---
import Base from '../layouts/Base.astro';
import { REPO_URL, SLOT_COUNT, slotId } from '../lib/site';
import { getRanking } from '../lib/ranking';

const { all, board } = await getRanking();
const cells = Array.from({ length: SLOT_COUNT }, (_, i) => ({ n: i + 1, p: board[i] }));
const fmt = (n: number) => n.toLocaleString('en-US');
const starsLabel = (n: number) => `${fmt(n)} ${n === 1 ? 'star' : 'stars'}`;
const nextOpen = all.length < SLOT_COUNT ? all.length + 1 : null;
const footText = board.length === 0 ? 'No projects yet. The first one to be merged takes slot 001.'
  : board.length < SLOT_COUNT ? `${board.length} of 100 slots filled. Tap a filled slot to see its project.`
  : 'The board is full. Tap a slot to see its project.';
---
<Base onInk>
  <section class="hero f-ink" aria-labelledby="hero-title">
    <h1 id="hero-title" class="display lines">
      <span class="line"><span data-line style="--i:0" data-i18n="hero.l1">100 projects.</span></span>
      <span class="line l2"><span data-line style="--i:1" data-i18n="hero.l2">One cause.</span></span>
    </h1>
    <div class="hero-foot">
      <p data-i18n="hero.lede">Projek Seratus is a Malaysian community building a hundred open-source projects for one shared cause. Anyone can join, and anyone can start their own.</p>
      <div class="actions">
        <a class="link" href="#board" data-i18n="hero.cta2">See the board</a>
        <a class="btn btn-kunyit" href="/apply"><span data-i18n="hero.cta1">Submit a project</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="board-sec f-paper wrap" id="board" aria-labelledby="board-title">
    <div class="grid">
      <div class="board-wrap" data-ui>
        <div class="board" id="board-grid" role="list" aria-label="The 100 most-starred projects">
          {cells.map((c) => (
            <button type="button" role="listitem" style={`--k:${c.n}`}
              class={`slot${c.p ? (c.n <= 10 ? ' is-top' : ' is-filled') : ''}`}
              data-n={c.n} disabled={!c.p}
              aria-label={c.p ? `Slot ${slotId(c.n)}: ${c.p.title}, ${starsLabel(c.p.stars)}` : `Slot ${slotId(c.n)}: open`}>{c.n}</button>
          ))}
        </div>
      </div>
      <div class="board-side">
        <h2 id="board-title" class="head" data-reveal data-i18n="board.title">The board</h2>
        <p class="count" data-reveal style="--d:1" aria-label={`${board.length} of 100 slots filled`}>{board.length}<small> / 100</small></p>
        <div class="slot-detail" id="slot-detail" aria-live="polite" data-reveal style="--d:2">
          <p class="msg">{footText}</p>
        </div>
        <div class="legend" aria-hidden="true" data-reveal style="--d:3">
          <span><i></i><span data-i18n="board.kOpen">Open</span></span>
          <span><i class="k-filled"></i><span data-i18n="board.kFilled">On the board</span></span>
          <span><i class="k-top"></i><span data-i18n="board.kTop">Top ten</span></span>
        </div>
      </div>
    </div>
    <script type="application/json" id="slots-data" set:html={JSON.stringify(board)} />
  </section>

  <section class="rank-sec f-kunyit wrap" id="ranking" aria-labelledby="rank-title">
    <h2 id="rank-title" class="head" data-reveal data-i18n="rank.title">Ranked by stars</h2>
    <p class="intro" data-reveal style="--d:1" data-i18n="rank.lede">Nobody claims a slot, and coming first doesn't help. GitHub stars are counted every day, and the hundred most-starred projects fill the board.</p>
    <ol class="poster">
      {all.slice(0, 7).map((p, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a class="name" href={p.github_url} target="_blank" rel="noopener nofollow">{p.title}</a>
          <span class="fact"><span data-stars={p.stars}>{starsLabel(p.stars)}</span>{p.website_url && <>{' · '}<a class="link" href={p.website_url} target="_blank" rel="noopener nofollow" data-i18n="board.website">Website</a></>}</span>
        </li>
      ))}
      {nextOpen && (
        <li class="open" data-reveal style={`--d:${Math.min(all.length, 7)}`}>
          <a class="name" href="/apply"><span data-i18n="rank.yours">Yours next</span></a>
          <span class="fact"><span data-i18n="rank.slot">Slot</span> {slotId(nextOpen)} · <a class="link" href="/apply" data-i18n="hero.cta1">Submit a project</a></span>
        </li>
      )}
    </ol>
  </section>

  <section class="how-sec f-ink wrap" id="how" aria-labelledby="how-title">
    <div class="grid">
      <div class="how-copy">
        <h2 id="how-title" class="head" data-reveal data-i18n="how.title">One file, one pull request</h2>
        <p data-reveal style="--d:1" data-i18n="how.p">There is no account to make and no database. Your project is a <strong>short file</strong> in the repository. The form writes it for you, and GitHub sends it as a pull request.</p>
        <div class="how-file" data-reveal style="--d:2" data-ui>
          <div class="term-bar"><span>submissions/projek-seratus.md</span></div>
<pre>---
title: "Projek Seratus"
github_url: <span class="k">https://github.com/rajahafify/projek-seratus</span>
website_url: https://projek-seratus.artifisi.com
---</pre>
        </div>
      </div>
      <div class="slip" data-reveal style="--d:2" data-ui>
        <p class="slip-title" data-i18n="how.slip">Getting on the board</p>
        <h3 data-i18n="how.g1">Today</h3>
        <ol>
          <li><span class="what" data-i18n="how.r1">Fill in the form</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t1">2 min</span></li>
          <li><span class="what" data-i18n="how.r2">Commit the file on GitHub</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t2">1 min</span></li>
          <li><span class="what" data-i18n="how.r3">Open the pull request</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t3">1 min</span></li>
        </ol>
        <h3 data-i18n="how.g2">Next</h3>
        <ol>
          <li><span class="what" data-i18n="how.r4">An automatic check reads the file</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t4">minutes</span></li>
          <li><span class="what" data-i18n="how.r5">An organiser merges it</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t5">by hand</span></li>
        </ol>
        <h3 data-i18n="how.g3">Every day after</h3>
        <ol>
          <li><span class="what" data-i18n="how.r6">Stars are counted again</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t6">daily</span></li>
          <li><span class="what" data-i18n="how.r7">The board is rebuilt</span><span class="dots" aria-hidden="true"></span><span class="when" data-i18n="how.t7">daily</span></li>
        </ol>
        <p class="total"><span data-i18n="how.total">Your project, ranked on the board</span><span data-i18n="how.totalT">4 min of your time</span></p>
      </div>
    </div>
  </section>

  <section class="room-sec f-paper wrap" id="join" aria-labelledby="room-title">
    <h2 id="room-title" class="head" data-reveal data-i18n="room.title">There is room for you</h2>
    <div class="room-text" data-reveal style="--d:1">
      <p data-i18n="room.p1"><strong>Projek Seratus</strong> is not only for developers. A project can be an <span class="hl">app</span>, a <span class="hl b">guide</span>, a <span class="hl c">dataset</span>, an event, a mural or a workshop, as long as it serves the cause and has a public GitHub repository to point to. Build one yourself, or lend your skills to someone else's: review their work, test what they ship, write their docs, or <span class="hl b">mentor a first-timer</span>.</p>
      <p data-i18n="room.p2">If you can't build this month, you can still move the board. <span class="hl">Star</span> the projects you believe in, share them, and bring in people who care. Joining is <span class="hl c">free</span>, and the code behind all of it is open. <a class="room-cta" href="/apply">Put your project on the board.</a></p>
    </div>
  </section>

  <section class="why-sec f-ink wrap" aria-labelledby="why-title">
    <div class="grid">
      <h2 id="why-title" class="head" data-reveal data-i18n="why.title">Why a hundred</h2>
      <p class="why-p" data-reveal style="--d:1" data-i18n="why.p">One project rarely moves a cause. A hundred of them, built by different people with different skills, <strong>start to add up to something people notice</strong>. A hundred is big enough to matter and small enough to finish.</p>
    </div>
    <div class="specimens grid">
      <div class="specimen one" data-reveal style="--d:0">
        <p class="fig" aria-label="One project">1</p>
      </div>
      <div class="specimen hundred" data-reveal style="--d:2">
        <p class="fig" aria-label="A hundred projects">100</p>
      </div>
    </div>
  </section>

  <section class="fork-sec f-paper2 wrap" id="fork" aria-labelledby="fork-title">
    <div class="grid">
      <div class="fork-copy">
        <h2 id="fork-title" class="head" data-reveal data-i18n="fork.title">Start your own hundred</h2>
        <p class="lead" data-reveal style="--d:1" data-i18n="fork.intro">Fork it, set your own cause, and run a hundred projects with your school, your office, your kampung or your city.</p>
        <ul class="fork-facts" data-reveal style="--d:2">
          <li data-i18n="fork.b1">The site, the board and the submission form come ready to use.</li>
          <li data-i18n="fork.b2">No database and no logins. Every project is a file, and every submission is a pull request.</li>
          <li data-i18n="fork.b3">It runs free on Cloudflare and rebuilds itself after every merge.</li>
        </ul>
        <div class="actions" data-reveal style="--d:3">
          <a class="btn btn-ink" href={REPO_URL} target="_blank" rel="noopener"><span data-i18n="fork.cta">View on GitHub</span> <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
      </div>
      <div class="term" data-reveal style="--d:2" data-ui>
        <div class="term-bar"><span>Terminal</span><button class="copy" id="copy-btn" type="button" data-i18n="fork.copy">Copy</button></div>
<pre id="cmd"><span class="c" data-i18n="fork.c1"># Fork on GitHub, then clone your copy</span>
git clone https://github.com/<span class="k">your-name</span>/projek-seratus.git
cd projek-seratus && npm install

<span class="c" data-i18n="fork.c2"># Set your cause and repo in src/lib/site.ts</span>

<span class="c" data-i18n="fork.c3"># Deploy to Cloudflare</span>
npm run deploy</pre>
        <p class="term-note" data-i18n="fork.note">Connect your fork to Cloudflare Workers Builds and every merge to <code>main</code> publishes a fresh board.</p>
      </div>
    </div>
  </section>

  <section class="faq-sec f-paper wrap" id="faq" aria-labelledby="faq-title">
    <div class="faq-row"><h2 id="faq-title" class="q" data-i18n="faq.title">Good to know</h2></div>
    <div class="faq-row" data-reveal><p class="q" data-i18n="faq.q1">Does it cost anything?</p><p class="a" data-i18n="faq.a1">No. Joining is free. You need a GitHub account, and the Projek Seratus code is free to use, change and share.</p></div>
    <div class="faq-row" data-reveal><p class="q" data-i18n="faq.q5">Do I need to be a developer?</p><p class="a" data-i18n="faq.a5">No. A guide, a dataset, an event or a workshop counts too. It needs a public GitHub repository, which can hold just a README.</p></div>
    <div class="faq-row" data-reveal><p class="q" data-i18n="faq.q2">How is the board decided?</p><p class="a" data-i18n="faq.a2">By GitHub stars, counted every day. The hundred most-starred projects fill the board, so places change as projects grow.</p></div>
    <div class="faq-row" data-reveal><p class="q" data-i18n="faq.q3">Can I submit more than one project?</p><p class="a" data-i18n="faq.a3">Yes. Open one pull request per project. Each repository can be submitted once.</p></div>
    <div class="faq-row" data-reveal><p class="q" data-i18n="faq.q6">Is there a group chat?</p><p class="a" data-i18n="faq.a6">Not yet. Watch the repository on GitHub and you'll hear about it first.</p></div>
  </section>
</Base>

<script>
  import '../scripts/board';
  import '../scripts/copy';
</script>
